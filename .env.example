# Copiá este archivo a .env y protegelo con chmod 600 .env.
# En systemd: /etc/origo/origo.env; no pongas secretos en el repositorio.
DATABASE_URL=sqlite:///./origo.db
# En producción: sqlite:////var/lib/origo/origo.db
TIMEZONE=America/Argentina/Buenos_Aires
# Tu nombre, como lo ven tus invitados ("Le debés $ 30.000 a Ana").
OWNER_NAME=Ana
BASE_URL=http://localhost:8000
# Producción (VPS o Tailscale): usá deploy/configure.py para generar un archivo
# privado con el origen HTTPS real y secretos aleatorios. Ver docs/despliegue.md.

# Obligatoria en HTTPS: al menos 32 bytes aleatorios, nunca un valor de ejemplo.
# Generá un valor distinto para cada secreto:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Sin usuarios nadie entra. Crealos con: uv run python -m app.cli create-user nombre
# Solo para desarrollo en localhost HTTP, nunca en HTTPS ni en una interfaz pública.
ORIGO_DEV_OPEN=0
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=86400

# MCP remoto: OAuth completo, bearer estático, o ambos. Vacíos = remoto deshabilitado.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ALLOWED_LOGIN=
# Alternativa para clientes simples: Authorization: Bearer <MCP_TOKEN>.
# Al menos 32 bytes aleatorios. Tiene acceso completo de dueño; no dárselo a invitados.
MCP_TOKEN=
# 1 = /mcp solo responde a llamadas desde esta misma máquina (Hermes); lo que llega por el
# proxy (incluido Tailscale Serve) o desde otra IP recibe 404. Desactiva el MCP remoto.
# Hermes en OTRA máquina o fuera del contenedor Docker: MCP_LOCAL_ONLY=0 + bearer,
# HTTPS entre máquinas y restricciones de red. Ver docs/agentes.md.
MCP_LOCAL_ONLY=0

# Límites para el agente, los aplica Origo (docs/agentes.md, "Límites del agente").
# MCP_ACCESS=read lo deja en solo lectura. MCP_DENY prohíbe tools: delete_*,clear_meal
MCP_ACCESS=write
MCP_DENY=
MCP_MAX_WRITES_PER_HOUR=60
MCP_MAX_BACKDATE_DAYS=45
# Tope por monto en la moneda local. 0 = sin tope.
MCP_MAX_AMOUNT=0

# Registro estructurado en stdout (journald). Nunca incluye cuerpos ni credenciales.
LOG_LEVEL=INFO
# Opcional: archivo rotativo, 5 MB × 6 archivos; en systemd debe quedar en /var/lib/origo.
LOG_FILE=
# HOME y XDG_DATA_HOME del servicio apuntan a /var/lib/origo para el estado de OAuth.
# BACKUP_RETENTION_DAYS=30 y ORIGO_DATA_DIR=/var/lib/origo se configuran en el servicio de backup.
