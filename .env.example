# Copiá este archivo a .env y completalo.
DATABASE_URL=sqlite:///./mentor.db
TIMEZONE=America/Argentina/Buenos_Aires

# Login web. Vacío = sin login (solo si la app corre en tu máquina).
APP_PASSWORD=
# Generalo con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# MCP remoto para Claude.ai / ChatGPT (OAuth con GitHub). Dejalo vacío para usar solo el MCP local.
BASE_URL=http://localhost:8000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ALLOWED_LOGIN=
