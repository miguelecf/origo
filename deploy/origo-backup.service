[Unit]
Description=Backup consistente de SQLite de Origo

[Service]
Type=oneshot
User=origo
Group=origo
ExecStart=/bin/sh /opt/origo/deploy/backup.sh
Environment=ORIGO_DATA_DIR=/var/lib/origo
Environment=BACKUP_RETENTION_DAYS=30
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/origo
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
